{
  "name": "hddp-website-monorepo",
  "version": "1.0.0",
  "description": "HDDP Consultants - Full Stack Website & API (Angular 17 + Express + Node.js)",
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "node backend/server.js",
    "start:prod": "node backend/dist/server.js",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend start"
  },
  "engines": {
    "node": ">=18.0.0 <=20.x",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "hddp",
    "recruitment",
    "angular",
    "express",
    "nodejs"
  ],
  "author": "HDDP Consultants",
  "license": "ISC"
}
