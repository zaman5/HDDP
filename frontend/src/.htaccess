# ==============================================================================
# HDDP Consultants - Apache .htaccess Configuration
# Features: SPA Routing, HTTPS Enforcement, Security Headers, Gzip/Brotli, Caching
# ==============================================================================

# Ensure index.html and index.php are default index files
DirectoryIndex index.html index.php

# Disable Directory Browsing and Content Negotiation (MultiViews interferes with SPA routing)
Options -Indexes -MultiViews

# ------------------------------------------------------------------------------
# 1. Enable Rewrite Engine & Force HTTPS
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS redirection for all HTTP requests
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Optional: Forward /api requests to Node.js backend if using mod_proxy
  <IfModule mod_proxy.c>
    RewriteCond %{REQUEST_URI} ^/api/(.*)$ [NC]
    RewriteRule ^api/(.*)$ http://127.0.0.1:4000/api/$1 [P,L]
  </IfModule>

  # PHP Fallback for live jobs if Node.js reverse proxy is not running
  RewriteRule ^api/careers/live-jobs/?$ jobs.php [L,QSA]

  # Prerendered Static Directory Trailing Slash & Fallback
  # If requested path is a directory and contains index.html, serve it
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Angular SPA HTML5 PushState Fallback
  # If requested resource is not an existing file or directory, serve root index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 2. Block Access to Hidden & Sensitive Files
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  # Block dotfiles (.env, .git, etc.)
  RewriteRule "(^|/)\.(?!well-known)" - [F]

  # Block direct web access to sensitive file extensions
  <FilesMatch "(^\.env|package\.json|package-lock\.json|tsconfig\.json|angular\.json|\.md|\.log|\.bak|\.sql)$">
    <IfModule mod_authz_core.c>
      Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
      Order allow,deny
      Deny from all
    </IfModule>
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 3. Security Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"

  # Protect against clickjacking (allow framing on same domain if needed)
  Header set X-Frame-Options "SAMEORIGIN"

  # Legacy XSS Protection for older browsers
  Header set X-XSS-Protection "1; mode=block"

  # Control Referrer Information
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict browser feature permissions
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Enforce HSTS (HTTP Strict Transport Security) - 1 year
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# ------------------------------------------------------------------------------
# 4. Gzip & Brotli Compression (mod_deflate)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ------------------------------------------------------------------------------
# 5. Browser Caching & Expiry (mod_expires)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Default fallback
  ExpiresDefault "access plus 2 days"

  # HTML documents (keep fresh for SPA navigation & deploys)
  ExpiresByType text/html "access plus 0 seconds"

  # CSS and JavaScript (Angular uses hash names in production)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Media: Images, Icons, Audio, Video
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # Feeds, XML, JSON
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ------------------------------------------------------------------------------
# 6. Correct MIME Types
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript js mjs
  AddType text/css css
  AddType image/svg+xml svg svgz
  AddType image/webp webp
  AddType image/avif avif
  AddType font/woff woff
  AddType font/woff2 woff2
  AddType application/json json
  AddType application/xml xml
</IfModule>
